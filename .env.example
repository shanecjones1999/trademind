HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Create this key in Massive's dashboard. Keep the real value out of source control.
MASSIVE_API_KEY=

# PostgreSQL connection string. The API applies the initial paper-account schema on startup.
DATABASE_URL=

# Google OpenID Connect. Register GOOGLE_REDIRECT_URL in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
APP_WEB_URL=http://localhost:3000/dashboard

# Generate with: openssl rand -base64 48
AUTH_SESSION_SECRET=
